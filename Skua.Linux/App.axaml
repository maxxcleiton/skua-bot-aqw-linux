<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skua.Linux.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />

        <!-- Global Typography & Surfaces -->
        <Style Selector="Window">
            <Setter Property="Background" Value="#11111B" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <!-- Cards -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#181825" />
            <Setter Property="BorderBrush" Value="#2B2C3D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Border.pill">
            <Setter Property="Background" Value="#232436" />
            <Setter Property="BorderBrush" Value="#313244" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <!-- Buttons -->
        <Style Selector="Button">
            <Setter Property="Background" Value="#252638" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderBrush" Value="#3B3D54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#313244" />
            <Setter Property="BorderBrush" Value="#585B70" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E1E2E" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#89B4FA" />
            <Setter Property="Foreground" Value="#11111B" />
            <Setter Property="BorderBrush" Value="#89B4FA" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#A6C8FF" />
            <Setter Property="Foreground" Value="#11111B" />
        </Style>

        <Style Selector="Button.success">
            <Setter Property="Background" Value="#A6E3A1" />
            <Setter Property="Foreground" Value="#11111B" />
            <Setter Property="BorderBrush" Value="#A6E3A1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.success:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C0F0BC" />
            <Setter Property="Foreground" Value="#11111B" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#F38BA8" />
            <Setter Property="Foreground" Value="#11111B" />
            <Setter Property="BorderBrush" Value="#F38BA8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F7A8BE" />
            <Setter Property="Foreground" Value="#11111B" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#CBA6F7" />
            <Setter Property="Foreground" Value="#11111B" />
            <Setter Property="BorderBrush" Value="#CBA6F7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#DBC0FA" />
            <Setter Property="Foreground" Value="#11111B" />
        </Style>

        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#313244" />
            <Setter Property="Foreground" Value="#BAC2DE" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#252638" />
        </Style>

        <!-- Compact Modern Tabs -->
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="Foreground" Value="#9399B2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="#CDD6F4" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#89B4FA" />
        </Style>

        <!-- Inputs -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#11111B" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderBrush" Value="#313244" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#1E1E2E" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderBrush" Value="#3B3D54" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Lists -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="#11111B" />
            <Setter Property="BorderBrush" Value="#2B2C3D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2D44" />
        </Style>
    </Application.Styles>
</Application>
